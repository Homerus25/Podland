#!/usr/bin/env bash
# Crush project configuration. See .crush/hooks/ for hook scripts.

# Format frontend files with Biome before every edit-type tool runs, so
# agents always read and edit already-formatted content and never need to
# run `biome check --write` manually.
hook add PreToolUse \
	--matcher '^(edit|multiedit|lsp_replace_symbol)$' \
	--command "$CRUSH_PROJECT_DIR/.crush/hooks/biome-format.sh" \
	--name biome-format

# Same for Go files with gofmt: keeps backend files canonical and catches
# indentation slips that build/vet/tests would silently pass.
hook add PreToolUse \
	--matcher '^(edit|multiedit|lsp_replace_symbol)$' \
	--command "$CRUSH_PROJECT_DIR/.crush/hooks/gofmt.sh" \
	--name gofmt-format

# Build the integration-tagged tests (backend/test/integration) so gopls
# stops warning "No packages found for open file" on those files.
lsp add go --command gopls \
	--options '{"buildFlags": ["-tags=integration"]}'
lsp add gopls --command gopls \
	--options '{"buildFlags": ["-tags=integration"]}'
