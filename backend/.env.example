# Server Configuration
PORT=8080
DATABASE_PATH=./podland.db

# JWT Configuration
JWT_PRIVATE_KEY_PATH=./jwt-private.pem
JWT_PUBLIC_KEY_PATH=./jwt-public.pem
JWT_EXPIRATION_MINUTES=60
JWT_ISSUER=podland

# Refresh sessions: days a login's refresh cookie stays redeemable
SESSION_TTL_DAYS=30

# SSH Connection Configuration
SSH_IDLE_TIMEOUT_SECONDS=900
MAX_CONCURRENT_MACHINES=100
CONNECTION_QUEUE_TIMEOUT_SECONDS=30
MACHINE_CONNECTION_TEST_TIMEOUT_SECONDS=10

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_USER_PER_MINUTE=60
# Login/refresh are unauthenticated, so their limiter keys by client IP
RATE_LIMIT_AUTH_REQUESTS_PER_IP_PER_MINUTE=10

# CORS
ALLOWED_ORIGINS=

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Encryption Key (32 bytes base64 encoded for AES-256)
ENCRYPTION_KEY=your-32-byte-base64-encoded-key-here
